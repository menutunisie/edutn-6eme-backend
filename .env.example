# Environnement d'execution : development | staging | production
ENVIRONMENT=development

# PostgreSQL (Railway fournit cette URL en production)
DATABASE_URL=postgresql://user:password@localhost:5432/edutn6

# Origines autorisees pour le CORS (separees par des virgules) : Flutter web/desktop/mobile
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Supabase Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key
SUPABASE_STORAGE_BUCKET=edutn6-resources

# JWT (utilise a partir de l'etape 3 - authentification)
JWT_SECRET_KEY=changeme-generate-a-strong-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
